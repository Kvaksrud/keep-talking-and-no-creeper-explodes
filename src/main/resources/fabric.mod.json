{
	"schemaVersion": 1,
	"id": "nocreeperexplodes",
	"version": "${version}",
	"name": "Keep Talking and No Creeper Explodes",
	"description": "Right-click a creeper to try defusing it: cut the right wire out of three and it can never explode again (it is sad about it). Cut the wrong one and... well.",
	"authors": [
		"Patrick"
	],
	"license": "CC0-1.0",
	"icon": "assets/nocreeperexplodes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"no.kvaksrud.nocreeperexplodes.NoCreeperExplodes"
		],
		"client": [
			"no.kvaksrud.nocreeperexplodes.client.NoCreeperExplodesClient"
		]
	},
	"mixins": [
		"nocreeperexplodes.mixins.json",
		{
			"config": "nocreeperexplodes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
